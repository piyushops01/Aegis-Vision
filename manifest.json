{
  "manifest_version": 3,
  "name": "AegisVision Live Shield",
  "version": "1.0.0",
  "description": "Front-line defense against phishing, social engineering, and deepfakes.",
  "action": {
    "default_popup": "extension-popup.html",
    "default_title": "AegisVision Shield"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
